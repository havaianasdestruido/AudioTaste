# AudioTaste — environment variables for Node scripts only.
# The browser app still needs the PUBLIC anon key in config.js
# (browsers cannot read .env files).
#
# Copy to .env and fill in your real values:
#   Supabase -> Project Settings -> API
SUPABASE_URL=https://your-project-url.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Used by the seed script to write past RLS (scrobbles are select-only
# for the anon key). Keep OUT of the browser — it's a full admin key.
# Supabase -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
