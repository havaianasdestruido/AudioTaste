# AudioTaste — environment variables for Node scripts only.
# The browser app still needs the PUBLIC anon key in config.js
# (browsers cannot read .env files).
#
# Copy to .env and fill in your real values:
#   Supabase -> Project Settings -> API
SUPABASE_URL=https://your-project-url.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Used by the seed script to write past RLS (scrobbles are select-only
# for the anon key). Keep OUT of the browser — it's a full admin key.
# Supabase -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Album art fetching (scripts/fetch_covers.mjs). Spotify first, Last.fm
# fallback. Spotify is OFF by default — set ENABLE_SPOTIFY=1 to turn it on.
# Keys stay local in .env, never shipped to the browser.
ENABLE_SPOTIFY=0
#   Spotify: https://developer.spotify.com/dashboard (create an app)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
#   Last.fm: https://www.last.fm/api/account/create (get an API key)
LASTFM_API_KEY=your-lastfm-api-key
